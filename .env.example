# ============================================================
# BullyGuard ID Environment Example
# Copy this file to .env and adjust the values.
# Do NOT commit your real .env file.
# ============================================================

# App mode: development | test | production
ENV=development

# Required for protected endpoints.
# Use a long random value in real deployment.
API_KEY=change_me_to_a_long_random_secret

# Backend server
HOST=0.0.0.0
PORT=8000

# CORS
# Use comma-separated origins.
# Development example:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_USER=cyber_user
POSTGRES_PASSWORD=cyber_password
POSTGRES_DB=cyberbullying_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_URL=postgresql://cyber_user:cyber_password@localhost:5432/cyberbullying_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cyber_redis_pass
REDIS_URL=redis://:cyber_redis_pass@localhost:6379/0

# Ollama / local LLM, optional
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ENABLE_LLM=false

# Hugging Face, optional
# Required only if your pipeline downloads gated/private models.
HF_TOKEN=

# Rate limit
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60

# Model configuration
MODEL_DIR=cyberbullying_api/models
DEFAULT_THRESHOLD=0.50

# Scraper-related files, optional
COOKIES_X_PATH=cyberbullying_api/cookies_x.json
TIKTOK_BROWSER_PROFILE=cyberbullying_api/tiktok_browser_profile

# Logging
LOG_LEVEL=INFO
