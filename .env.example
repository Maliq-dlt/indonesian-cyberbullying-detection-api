# ==========================================================
# BullyGuard ID environment example
# Copy to .env and replace values before running Docker Compose.
# ==========================================================

# local | development | test | production
ENV=development

# Required in production/staging. Optional in local dev only when ALLOW_MISSING_API_KEY_IN_DEV=true.
API_KEY=change_this_to_a_long_random_secret
ALLOW_MISSING_API_KEY_IN_DEV=true

# Database
POSTGRES_USER=cyber_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=cyberbullying_db
PG_URL=postgresql://cyber_user:change_this_postgres_password@db:5432/cyberbullying_db

# Redis
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@redis:6379/0

# External services
OLLAMA_URL=http://host.docker.internal:11434
HF_TOKEN=

# CORS
# Production must use exact domains. Do not use *.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate limit
RATE_LIMIT_REQUESTS_PER_MINUTE=15
RATE_LIMIT_WINDOW_SECONDS=60
# development: true is acceptable. production: must be false.
RATE_LIMIT_FAIL_OPEN=true

# Reverse proxy
# Set true only if API is behind a trusted reverse proxy that sets X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS=false

# Webhook protection
# Optional allowlist, comma-separated. Example: hooks.slack.com,discord.com
WEBHOOK_ALLOWED_HOSTS=

# Ports
API_PORT=8000
WEB_PORT=3000

# Production override
API_WORKERS=1
VITE_API_BASE_URL=http://localhost:8000
